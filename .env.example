# GATE Companion EC - Environment Configuration Template
# NOTE: The application is designed to be fully functional locally and offline
# without requiring any API credentials. These variables are optional.

# Optional Supabase Backend (leave blank for local-first IndexedDB/localStorage mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Optional AI Explanation API Endpoint & Key (e.g., Gemini API via secure proxy or Cloud Function)
VITE_AI_API_ENDPOINT=https://your-api-proxy.example.com/api/explain
VITE_AI_API_KEY=your-ai-api-key-placeholder

